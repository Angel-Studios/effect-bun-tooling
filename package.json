{
  "name": "effect-bun-tooling",
  "version": "0.2.1",
  "private": true,
  "description": "General-purpose Effect + Bun test tooling. Public, standalone, source-TypeScript packages consumed with no build step.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Angel-Studios/effect-bun-tooling.git"
  },
  "packageManager": "pnpm@11.1.1+sha512.d1fdf5f73c617b64fa1a56a81c3c8dfe0e966e33a6010aa256b517ae77be21d93e05affc0de1a83b0e4f29d569f68b446ae8f068cd7247c0bb3df0fb4d7bdf9a",
  "type": "module",
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "@biomejs/biome": "2.5.4",
      "@effect/language-service": "0.87.1",
      "@effect/platform": "0.97.1",
      "@types/node": "24.12.4",
      "@types/bun": "1.3.14",
      "effect": "3.22.1",
      "typescript": "6.0.3"
    }
  },
  "engines": {
    "bun": ">=1.3.12",
    "node": ">=22.13",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "check": "biome check --write --no-errors-on-unmatched --error-on-warnings",
    "check:ci": "biome check --reporter=github --error-on-warnings",
    "tsc": "tsc --noEmit && pnpm -r --if-present run tsc",
    "test:unit:once": "bun test && pnpm -r --if-present run test:unit:once",
    "test:e2e": "bun test ./__e2e__/*.e2e.test.ts",
    "dod": "pnpm run tsc && pnpm run test:unit:once && pnpm run check:ci",
    "pack:workspace": "bun scripts/pack-workspace.ts",
    "version:set": "bun scripts/set-version.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@effect/language-service": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "typescript": "catalog:"
  }
}
