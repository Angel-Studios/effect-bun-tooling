{
  "name": "effect-bun-tooling",
  "version": "0.2.1",
  "private": true,
  "description": "General-purpose Effect + Bun test tooling. Public, standalone, source-TypeScript packages consumed with no build step.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Angel-Studios/effect-bun-tooling.git"
  },
  "packageManager": "bun@1.3.14",
  "type": "module",
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "@biomejs/biome": "2.5.4",
      "@effect/tsgo": "0.36.5",
      "@types/node": "24.12.4",
      "@types/bun": "1.3.14",
      "effect": "4.0.0-rc.109",
      "typescript": "7.0.2"
    }
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "check": "biome check --write --no-errors-on-unmatched --error-on-warnings",
    "check:ci": "biome check --reporter=github --error-on-warnings",
    "tsc": "tsc --noEmit && bun run --filter '@packages/*' tsc",
    "lint:effect": "effect-tsgo diagnostics --project tsconfig.json && bun run --filter '@packages/*' lint:effect",
    "test:unit:once": "bun test && bun run --filter '@packages/*' test:unit:once",
    "test:e2e": "bun test ./__e2e__/*.e2e.test.ts",
    "dod": "bun run tsc && bun run lint:effect && bun run test:unit:once && bun run check:ci",
    "pack:workspace": "bun scripts/pack-workspace.ts",
    "version:set": "bun scripts/set-version.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@effect/tsgo": "catalog:",
    "@packages/fixture-residue": "workspace:*",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "typescript": "catalog:"
  }
}
