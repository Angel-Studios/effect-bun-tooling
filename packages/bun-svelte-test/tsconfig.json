{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "types": [
      "bun"
    ],
    "paths": {
      "$app/environment": ["./src/app-doubles/environment.ts"],
      "$app/navigation": ["./src/app-doubles/navigation.ts"],
      "$app/state": ["./src/app-doubles/state.ts"]
    }
  },
  "include": [
    "src",
    "__test__"
  ],
  "exclude": [
    "node_modules"
  ]
}
