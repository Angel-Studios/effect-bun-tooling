{
  "name": "@packages/bun-svelte-test",
  "version": "0.4.1",
  "description": "Bun.plugin Svelte 5 compiler loader plus a happy-dom preload for bun test. Lets `bun test` compile and mount .svelte components and .svelte.ts runes modules, retiring the vitest carve-out that existed solely because bun has no native .svelte loader.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Angel-Studios/effect-bun-tooling.git",
    "directory": "packages/bun-svelte-test"
  },
  "homepage": "https://github.com/Angel-Studios/effect-bun-tooling/tree/main/packages/bun-svelte-test",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "default": "./dist/register.js"
    },
    "./mount": {
      "types": "./dist/mount.d.ts",
      "default": "./dist/mount.js"
    },
    "./app-doubles/navigation": {
      "types": "./dist/app-doubles/navigation.d.ts",
      "default": "./dist/app-doubles/navigation.js"
    },
    "./app-doubles/state": {
      "types": "./dist/app-doubles/state.d.ts",
      "default": "./dist/app-doubles/state.js"
    },
    "./app-doubles/environment": {
      "types": "./dist/app-doubles/environment.d.ts",
      "default": "./dist/app-doubles/environment.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.3.12"
  },
  "scripts": {
    "tsc": "tsc --noEmit",
    "build:types": "tsc --project tsconfig.build.json",
    "lint:effect": "effect-tsgo diagnostics --project tsconfig.json",
    "check": "biome check src/ __test__/",
    "test:unit:once": "bun test"
  },
  "dependencies": {
    "@happy-dom/global-registrator": "20.9.0",
    "@types/bun": "^1.3.14",
    "happy-dom": "20.9.0"
  },
  "peerDependencies": {
    "effect": ">=4.0.0-rc.109 <5",
    "svelte": "^5.56.8"
  },
  "devDependencies": {
    "@packages/effect-bun-test": "workspace:*",
    "@testing-library/svelte": "5.3.1",
    "effect": "catalog:",
    "svelte": "5.56.8",
    "typescript": "catalog:"
  }
}
