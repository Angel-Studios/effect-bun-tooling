{
  "name": "@packages/ddd-meta",
  "version": "0.5.0",
  "description": "The front-matter FORMAT: a schema-validated TOML metadata block carried in a comment at the top of an owned, comment-capable file, plus the four per-language comment carriers (block, hash, apostrophe, xml) that read and write one identical payload. Closed 11-field registry whose governing rule is that a field is legitimate only when no AST can PRODUCE its value; refutable-but-not-derivable is the point. Ships the format and ZERO vocabulary: layer/pattern/subdomain/tier members arrive as injected data, never as a second copy of someone else's truth.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Angel-Studios/effect-bun-tooling.git",
    "directory": "packages/ddd-meta"
  },
  "homepage": "https://github.com/Angel-Studios/effect-bun-tooling/tree/main/packages/ddd-meta",
  "type": "module",
  "exports": {
    "./parse": {
      "types": "./dist/parse.d.ts",
      "default": "./dist/parse.js"
    },
    "./write": {
      "types": "./dist/write.d.ts",
      "default": "./dist/write.js"
    },
    "./sentinel": {
      "types": "./dist/sentinel.d.ts",
      "default": "./dist/sentinel.js"
    },
    "./carrier": {
      "types": "./dist/carrier.d.ts",
      "default": "./dist/carrier.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "default": "./dist/registry.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "default": "./dist/errors.js"
    },
    "./exclude": {
      "types": "./dist/exclude.d.ts",
      "default": "./dist/exclude.js"
    },
    "./vocabulary": {
      "types": "./dist/vocabulary.d.ts",
      "default": "./dist/vocabulary.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.3.12"
  },
  "scripts": {
    "tsc": "tsc --noEmit",
    "build:types": "tsc --project tsconfig.build.json",
    "lint:effect": "effect-tsgo diagnostics --project tsconfig.json",
    "check": "biome check src/ __tests__/",
    "test:unit:once": "bun test"
  },
  "peerDependencies": {
    "effect": ">=4.0.0-rc.109 <5"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "effect": "catalog:",
    "typescript": "catalog:"
  }
}
