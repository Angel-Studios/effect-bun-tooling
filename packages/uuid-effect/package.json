{
  "name": "@packages/uuid-effect",
  "version": "0.4.1",
  "description": "Effect-native UUID service: crypto-entropy UUIDs injected through Effect context (mockable in tests, no PRNG downgrade)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Angel-Studios/effect-bun-tooling.git",
    "directory": "packages/uuid-effect"
  },
  "homepage": "https://github.com/Angel-Studios/effect-bun-tooling/tree/main/packages/uuid-effect",
  "type": "module",
  "exports": {
    "./tag": {
      "types": "./dist/tag.d.ts",
      "default": "./dist/tag.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./layer.live": {
      "types": "./dist/layer.live.d.ts",
      "default": "./dist/layer.live.js"
    },
    "./layer.test": {
      "types": "./dist/layer.test.d.ts",
      "default": "./dist/layer.test.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.3.12"
  },
  "scripts": {
    "tsc": "tsc --noEmit",
    "build:types": "tsc --project tsconfig.build.json",
    "lint:effect": "effect-tsgo diagnostics --project tsconfig.json",
    "check": "biome check src/ __tests__/",
    "test:unit:once": "bun test --coverage"
  },
  "peerDependencies": {
    "effect": ">=4.0.0-rc.109 <5"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "effect": "catalog:",
    "typescript": "catalog:"
  }
}
